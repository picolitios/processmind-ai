POSTGRES_DB=processmind
POSTGRES_USER=processmind
POSTGRES_PASSWORD=change-me-local
IDENTITY_DB_PASSWORD=replace-with-unique-random-32-char-secret
BUSINESS_DB_PASSWORD=replace-with-another-random-32-char-secret
DATABASE_URL=postgresql+psycopg://processmind:change-me-local@127.0.0.1:5432/processmind
WEB_ORIGIN=http://localhost:5173
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_MODE=plain
SMTP_FROM=convites@processmind.local
# For an external SMTP relay, set SMTP_MODE=starttls (or ssl), SMTP_USERNAME and SMTP_PASSWORD privately.
APP_ENV=local
AUTH_HASH_KEY=local-only-replace-before-production
MAX_UPLOAD_BYTES=20971520
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=30
RABBITMQ_USER=processmind
RABBITMQ_PASSWORD=change-me-local
RABBITMQ_HOST=127.0.0.1
AUDIT_DISPATCH_MODE=database
AUDIT_MONITOR_INTERVAL_SECONDS=60
AUDIT_MONITOR_MAX_PENDING_AGE_SECONDS=300
AUDIT_CONFIG_MODE=owned
BUSINESS_AUTH_MODE=database
IDENTITY_INTERNAL_URL=http://127.0.0.1:8001
