# Copy to the repository root as .env on the VM, replace every secret, chmod 600.
# DNS must point to the VM and allow inbound TCP 80/443 before first start.
COMPOSE_PROJECT_NAME=processmind_demo
DEMO_HOST=demo.example.org
WEB_ORIGIN=https://demo.example.org
APP_ENV=demo
POSTGRES_DB=processmind
POSTGRES_USER=processmind
POSTGRES_PASSWORD=replace-with-unique-random-hex
IDENTITY_DB_PASSWORD=replace-with-another-unique-random-hex
BUSINESS_DB_PASSWORD=replace-with-a-third-unique-random-hex
AUTH_HASH_KEY=replace-with-64-random-hex-characters
RABBITMQ_USER=processmind
RABBITMQ_PASSWORD=replace-with-a-fourth-unique-random-hex
# No paid inference API is used. This unreachable local endpoint gives an explicit fallback.
OLLAMA_BASE_URL=http://127.0.0.1:1
